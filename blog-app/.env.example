APP_NAME="Blog Application"
APP_ENV=development
APP_DEBUG=false
BASE_URL=http://localhost:8000

# Database Connection (Replace with your actual credentials)
DB_HOST=localhost
DB_NAME=blog_app
DB_USER=your_db_user
DB_PASS=your_db_password
DB_CHARSET=utf8mb4

# Security Settings
SESSION_LIFETIME=86400
CSRF_PROTECTION=true
